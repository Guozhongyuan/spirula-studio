+static bool
+frame_is_resizing(const struct libdecor_frame_gtk *frame_gtk)
+{
+	return frame_gtk->throttled_redraw;
+}
+
+static void
+redraw_frame_now(struct libdecor_frame_gtk *frame_gtk)
+{
+	frame_gtk->throttled_redraw = false;
+	draw_decoration(frame_gtk);
+	libdecor_frame_toplevel_commit(&frame_gtk->frame);
+}
+
+static bool
+has_post_resize_redraw_pending(struct libdecor_plugin_gtk *plugin_gtk)
+{
+	struct libdecor_frame_gtk *frame_gtk;
+
+	wl_list_for_each(frame_gtk, &plugin_gtk->visible_frame_list, link) {
+		if (frame_gtk->post_resize_redraw_pending)
+			return true;
+	}
+
+	return false;
+}
+
+static void
+flush_post_resize_redraws(struct libdecor_plugin_gtk *plugin_gtk, bool force)
+{
+	struct libdecor_frame_gtk *frame_gtk;
+	const gint64 now = g_get_monotonic_time();
+
+	wl_list_for_each(frame_gtk, &plugin_gtk->visible_frame_list, link) {
+		if (!frame_gtk->post_resize_redraw_pending)
+			continue;
+		if (!force &&
+		    (frame_gtk->window_state & LIBDECOR_WINDOW_STATE_RESIZING))
+			continue;
+		if (!force &&
+		    now - frame_gtk->last_resize_commit_us < RESIZE_POST_REDRAW_DELAY_US)
+			continue;
+
+		redraw_frame_now(frame_gtk);
+		frame_gtk->post_resize_redraw_pending = false;
+	}
+}
+
+static void
+flush_deferred_header_redraws(struct libdecor_plugin_gtk *plugin_gtk)
+{
+	struct libdecor_frame_gtk *frame_gtk;
+
+	wl_list_for_each(frame_gtk, &plugin_gtk->visible_frame_list, link) {
+		if (!frame_gtk->header_draw_deferred)
+			continue;
+
+		redraw_frame_now(frame_gtk);
+	}
+}
+
+static GtkWidget **
+header_widget_cache_slot(struct libdecor_frame_gtk *frame_gtk,
+			 enum header_element type)
+{
+	switch (type) {
+	case HEADER_TITLE:
+		return &frame_gtk->header_title_widget;
+	case HEADER_MIN:
+		return &frame_gtk->header_min_widget;
+	case HEADER_MAX:
+		return &frame_gtk->header_max_widget;
+	case HEADER_CLOSE:
+		return &frame_gtk->header_close_widget;
+	default:
+		return NULL;
+	}
+}
+
+static void
+set_header_widget_cache_slot(GtkWidget **slot, GtkWidget *widget)
+{
+	if (!slot || *slot == widget)
+		return;
+
+	if (*slot) {
+		g_object_remove_weak_pointer(G_OBJECT(*slot),
+					     (gpointer *) slot);
+	}
+
+	*slot = widget;
+
+	if (*slot) {
+		g_object_add_weak_pointer(G_OBJECT(*slot),
+					  (gpointer *) slot);
+	}
+}
+
+static void
+reset_header_widget_cache(struct libdecor_frame_gtk *frame_gtk)
+{
+	set_header_widget_cache_slot(&frame_gtk->header_title_widget, NULL);
+	set_header_widget_cache_slot(&frame_gtk->header_min_widget, NULL);
+	set_header_widget_cache_slot(&frame_gtk->header_max_widget, NULL);
+	set_header_widget_cache_slot(&frame_gtk->header_close_widget, NULL);
+}
+
+static GtkWidget *
+get_cached_header_widget(struct libdecor_frame_gtk *frame_gtk,
+			 enum header_element type)
+{
+	GtkWidget **slot = header_widget_cache_slot(frame_gtk, type);
+
+	if (!GTK_IS_WIDGET(frame_gtk->header))
+		return NULL;
+
+	if (!slot)
+		return NULL;
+
+	if (*slot)
+		return *slot;
+
+	set_header_widget_cache_slot(slot,
+				     find_widget_by_type(frame_gtk->header, type).widget);
+
+	return *slot;
+}
+
+static int
+get_title_bar_height(struct libdecor_frame_gtk *frame_gtk)
+{
+	if (!GTK_IS_WIDGET(frame_gtk->header))
+		return 0;
+
+	if (!frame_gtk->title_height_valid) {
+		gtk_widget_show_all(frame_gtk->window);
+		gtk_widget_get_preferred_height(frame_gtk->header, NULL,
+						&frame_gtk->cached_title_height);
+		frame_gtk->title_height_valid = true;
+	}
+
+	return frame_gtk->cached_title_height;
+}
